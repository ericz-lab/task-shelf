# task-shelf: copy to .env for a local run. ai-space's space.env supplies PORT, DATABASE_URL,
# SPACE_API_URL, SPACE_NAME and SPACE_APP_TOKEN in deployment; never commit a filled .env.

# ai-space runtime for agent jobs (one with the agent capability).
SHELF_AGENT_RUNTIME=claude
# Zone for a new job when neither the person nor the page names one (the page sends the browser's).
SHELF_DEFAULT_TZ=UTC
# How long one assistant turn may wait for the model (ms).
SHELF_ASSISTANT_TIMEOUT_MS=120000
# Changing ai-space tasks needs the operator credential. By default it is read from
# <workspace>/run/operator-token (derived from SPACE_APP_DATA_DIR); set a path here to read another
# file, or set SPACE_API_TOKEN. Without one the page lists tasks but cannot change them.
# SHELF_OPERATOR_TOKEN_FILE=

# Local run only (ai-space sets these itself):
# PORT=9145
# DATABASE_URL=sqlite:///absolute/path/main.db
# SPACE_API_URL=http://127.0.0.1:8700
# SPACE_APP_TOKEN=...
# SPACE_NAME=...
